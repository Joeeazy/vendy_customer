# Where the customer API runs (uvicorn customer.main:app --port 8002).
# Used by Next to forward /customer/* in development and for server-side fetches.
CUSTOMER_API_URL=http://localhost:8002

# The chat WebSocket. Behind nginx this is wss://<your-domain>/chat/ws.
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:8004/ws

# "Work with us" link to the vendor app
NEXT_PUBLIC_VENDOR_APP_URL=http://localhost:3001

# Optional support contacts shown on the home page and footer. Leave any of
# them empty and it is not shown.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_VENDOR_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_OFFICE_ADDRESS=
