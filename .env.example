# Where the customer API runs (uvicorn customer.main:app --port 8002).
# Used by Next to forward /customer/* in development and for server-side fetches.
CUSTOMER_API_URL=http://localhost:8002

# The chat WebSocket. Behind nginx this is wss://<your-domain>/chat/ws.
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:8004/ws
